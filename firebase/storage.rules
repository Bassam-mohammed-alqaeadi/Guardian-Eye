rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member(familyId) { return request.auth != null && firestore.exists(/databases/(default)/documents/families/$(familyId)/members/$(request.auth.uid)); }
    match /families/{familyId}/{allPaths=**} { allow read: if member(familyId); allow write: if member(familyId) && request.resource.size < 10 * 1024 * 1024; }
  }
}
